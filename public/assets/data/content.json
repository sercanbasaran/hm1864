    "template.0148": {
      "tr": "İSTANBUL TATLI MİRASI,",
      "en": "",
      "ar": ""
    },
    "template.0149": {
      "tr": "ŞİMDİ TÜM DÜNYADA",
      "en": "",
      "ar": ""
    },
    "template.0150": {
      "tr": "1864 yılında İstanbul’un tarihi kalbi Bahçekapı’da başlayan serüvenimiz, bugün geleneksel ustalık ve köklü lezzet anlayışımızla sınırları aşarak devam ediyor.",
      "en": "",
      "ar": ""
    },
    "template.0151": {
      "tr": "İstanbul’un eşsiz tatlı mirasını; İstanbul, Dubai ve Londra mağazalarımızla tatlı severlerle buluşturuyoruz.",
      "en": "",
      "ar": ""
    },
