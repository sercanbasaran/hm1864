    "template.0137": {
      "tr": "HAFIZ MUSTAFA 1864",
      "en": "",
      "ar": ""
    },
    "template.0138": {
      "tr": "İş dünyasında kurulan güçlü bağları, incelikle düşünülmüş ve anlam dolu teşekkür jestleriyle pekiştirin.",
      "en": "",
      "ar": ""
    },
    "template.0139": {
      "tr": "ZAMANSIZ PRESTİJ",
      "en": "",
      "ar": ""
    },
    "template.0140": {
      "tr": "İstanbul’un tatlı mirasını, markanızın ağırlığı ve zarafetiyle harmanlıyoruz.",
      "en": "",
      "ar": ""
    },
    "template.0141": {
      "tr": "HER ANI DEĞERLİ KILAN SEÇENEKLER",
      "en": "",
      "ar": ""
    },
    "template.0142": {
      "tr": "Özel kutlamalar, yeni yıl tebrikleri ve kurumsal etkinlikler için baklava, lokum ve kahve koleksiyonlarımız.",
      "en": "",
      "ar": ""
    },
    "template.0143": {
      "tr": "EŞSİZ LEZZET GARANTİSİ",
      "en": "",
      "ar": ""
    },
    "template.0144": {
      "tr": "1864’ten bu yana değişmeyen özgün reçetelerimizle, hafızalarda iz bırakacak bir lezzet deneyimi.",
      "en": "",
      "ar": ""
    },
    "template.0145": {
      "tr": "KURUMSAL ÇÖZÜMLER İÇİN İLETİŞİME GEÇİN",
      "en": "",
      "ar": ""
    },
    "template.0146": {
      "tr": "Bahçekapı Mağazası — 1864",
      "en": "",
